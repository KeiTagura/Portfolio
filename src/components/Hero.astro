---
import HeroThreeScene from "@components/HeroThreeScene.astro";
import { links } from "@data/links";
import { withBase } from "../utils/paths";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-media" aria-hidden="true">
    <HeroThreeScene />
  </div>
  <div class="hero-content">
    <p class="eyebrow">Senior Programmer / Technical Artist</p>
    <h1 id="hero-title">Grant Klein</h1>
    <p class="hero-copy">
      Unity, Unreal Engine, VR/AR, technical art, tooling, and full-stack web development for production teams
      and interactive experiences.
    </p>
    <div class="hero-actions">
      <a class="button primary" href={withBase("/projects")}>View Projects</a>
      <a class="button secondary" href={withBase(links.cv)}>Download CV</a>
    </div>
  </div>
</section>
