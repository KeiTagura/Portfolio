---
import HeroThreeScene from "@components/HeroThreeScene.astro";
import { links } from "@data/links";
import { withBase } from "../utils/paths";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-media" aria-hidden="true">
    <HeroThreeScene />
  </div>
  <div class="hero-content">
    <p class="eyebrow">Senior Programmer / Technical Artist</p>
    <h1 id="hero-title">Klein Grant</h1>
    <p class="hero-copy">
      10+ years of experience as a senior programmer and technical artist across game development, VR/AR, tooling, shaders, and web platforms.
    </p>
    <div class="hero-actions">
      <a class="button primary" href={withBase(links.cv)}>Download CV</a>
    </div>
  </div>
  <a class="hero-scroll-cue" href="#projects" aria-label="Scroll to featured projects">
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
  </a>
</section>
