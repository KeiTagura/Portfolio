---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  actionHref?: string;
  actionLabel?: string;
  variant?: "compact" | "page";
}

const { eyebrow, title, description, actionHref, actionLabel, variant = "compact" } = Astro.props;
---

<div class:list={["section-header", `section-header-${variant}`]}>
  <div>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>{title}</h2>
    {description && <p>{description}</p>}
  </div>
  {actionHref && actionLabel && <a class="text-link" href={actionHref}>{actionLabel}</a>}
</div>
