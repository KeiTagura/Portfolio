---
import { site } from "@config/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = site.title,
  description = site.description,
  image = site.ogImage,
} = Astro.props;

const pageTitle = title === site.title ? title : `${title} | ${site.name}`;
const siteUrl = site.url.endsWith("/") ? site.url : `${site.url}/`;
const basePath = import.meta.env.BASE_URL;
let pathname = Astro.url.pathname;

if (basePath !== "/" && pathname.startsWith(basePath)) {
  pathname = pathname.slice(basePath.length - 1) || "/";
}

const canonicalPath = pathname.replace(/^\//, "");
const canonical = new URL(canonicalPath, siteUrl);
const ogImagePath = image.replace(/^\//, "");
const ogImage = new URL(ogImagePath, siteUrl);
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content={site.locale} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
