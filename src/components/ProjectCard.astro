---
import type { CollectionEntry } from "astro:content";
import { site } from "@config/site";
import { getUi } from "@data/ui";
import { withBase } from "../utils/paths";

interface Props {
  project: CollectionEntry<"projects">;
  variant?: "home" | "page";
  index: number;
  thumbnailSrc?: string;
  mediaSrc?: string;
}

const { project, variant = "home", index, thumbnailSrc, mediaSrc } = Astro.props;
const { data } = project;
const ui = getUi();
const resolvedThumbnailSrc = thumbnailSrc ?? withBase(data.thumbnail);
const resolvedMediaSrc = mediaSrc ?? withBase(data.mediaSrc);
---

<article class:list={["project-card", `project-card-${variant}`]}>
  <button
    type="button"
    class="project-open-button"
    data-project-lightbox-trigger
    data-project-index={index}
    data-media-type={data.mediaType}
    data-media-src={resolvedMediaSrc}
    data-project-url={data.projectUrl ? withBase(data.projectUrl) : undefined}
    data-title={data.title}
    aria-label={`${ui.common.openProject}: ${data.title}`}
  ></button>
  <div class="project-image" aria-hidden="true">
    <img src={resolvedThumbnailSrc} alt={`${data.title} preview`} loading="lazy" />
  </div>
  <div class="project-body">
    <div class="project-meta">
      <span>{data.role}</span>
    </div>
    <h3>{data.title}</h3>
    {site.projectThumbnail.showDescription && <p>{data.description}</p>}
  </div>
</article>
