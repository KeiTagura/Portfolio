---
import { site } from "@config/site";
import { withBase } from "../utils/paths";

const visual = site.heroVisual;
const sceneId = "hero-three-scene";
const fallbackImage = withBase(visual.fallbackImage);
const modelUrl = withBase(visual.modelUrl);
const modelTextureUrl = visual.modelTextureUrl ? withBase(visual.modelTextureUrl) : "";
const modelAnimation = visual.modelAnimation;
const modelView = visual.modelView;
const orbit = visual.orbit;
const ascii = visual.ascii;
const fallbackTint = visual.fallbackTint;
const mediaOverlay = visual.mediaOverlay;
const backgroundTitle = visual.backgroundTitle;
const splitPosition = Math.min(1, Math.max(0, visual.splitPosition));
const splitSoftness = Math.min(0.25, Math.max(0, visual.splitSoftness));
const overlayOpacity = mediaOverlay.visible ? Math.min(1, Math.max(0, mediaOverlay.opacity)) : 0;
const normalTitleColor =
  visual.asciiSide === "left" ? backgroundTitle.asciiColor : backgroundTitle.normalColor;
const asciiTitleColor =
  visual.asciiSide === "left" ? backgroundTitle.normalColor : backgroundTitle.asciiColor;
const visualStyles = [
  `--hero-fallback-image: url("${fallbackImage}")`,
  `--hero-fallback-tint-color: ${fallbackTint.color}`,
  `--hero-fallback-tint-blend-mode: ${fallbackTint.blendMode}`,
  `--hero-media-overlay-opacity: ${overlayOpacity}`,
  `--hero-split-position: ${splitPosition * 100}%`,
  `--hero-split-softness: ${splitSoftness * 100}%`,
  `--hero-split-line-color: rgba(255, 207, 90, ${visual.showSplitLine ? 0.22 : 0})`,
  `--hero-background-title-normal-color: ${normalTitleColor}`,
  `--hero-background-title-ascii-color: ${asciiTitleColor}`,
  `--hero-background-title-opacity: ${backgroundTitle.opacity}`,
  `--hero-background-title-font-size: ${backgroundTitle.fontSize}`,
  `--hero-background-title-mobile-font-size: ${backgroundTitle.mobileFontSize}`,
  `--hero-background-title-x: ${backgroundTitle.x}`,
  `--hero-background-title-y: ${backgroundTitle.y}`,
  `--hero-background-title-gradient-angle: ${90 + visual.splitAngle}deg`,
].join("; ");
---

<div
  class:list={["hero-visual", { "hero-visual-disabled": !visual.enabled }]}
  aria-hidden="true"
  data-hero-visual
  style={visualStyles}
>
  <div class="hero-visual-fallback"></div>
  {
    visual.enabled && (
      <div
        id={sceneId}
        class="hero-three-scene"
        data-hero-three-scene
        data-enabled={String(visual.enabled)}
        data-mode={visual.mode}
        data-render-mode={visual.renderMode}
        data-debug-gui-enabled={String(visual.debugGui.enabled)}
        data-debug-gui-show-in-production={String(visual.debugGui.showInProduction)}
        data-debug-gui-start-open={String(visual.debugGui.startOpen)}
        data-debug-gui-width={visual.debugGui.width}
        data-debug-gui-enable-with-query-param={String(visual.debugGui.enableWithQueryParam)}
        data-media-overlay-visible={String(mediaOverlay.visible)}
        data-media-overlay-opacity={overlayOpacity}
        data-fallback-tint-color={fallbackTint.color}
        data-fallback-tint-blend-mode={fallbackTint.blendMode}
        data-background-title-enabled={String(backgroundTitle.enabled)}
        data-background-title-text={backgroundTitle.text}
        data-background-title-normal-color={backgroundTitle.normalColor}
        data-background-title-ascii-color={backgroundTitle.asciiColor}
        data-background-title-opacity={backgroundTitle.opacity}
        data-background-title-font-size={backgroundTitle.fontSize}
        data-background-title-mobile-font-size={backgroundTitle.mobileFontSize}
        data-background-title-x={backgroundTitle.x}
        data-background-title-y={backgroundTitle.y}
        data-model-source={visual.modelSource}
        data-model-url={modelUrl}
        data-model-material-mode={visual.modelMaterialMode}
        data-model-texture-source={visual.modelTextureSource}
        data-model-texture-url={modelTextureUrl}
        data-model-animation-enabled={String(modelAnimation.enabled)}
        data-model-animation-clip={modelAnimation.clip}
        data-model-animation-loop={String(modelAnimation.loop)}
        data-model-animation-clamp={String(modelAnimation.clampWhenFinished)}
        data-model-animation-time-scale={modelAnimation.timeScale}
        data-model-view-camera-distance={modelView.cameraDistance}
        data-model-view-camera-y={modelView.cameraY}
        data-model-view-camera-fov={modelView.cameraFov}
        data-model-view-fit-size={modelView.modelFitSize}
        data-model-view-position-x={modelView.position.x}
        data-model-view-position-y={modelView.position.y}
        data-model-view-position-z={modelView.position.z}
        data-ascii-side={visual.asciiSide}
        data-split-position={splitPosition}
        data-split-angle={visual.splitAngle}
        data-split-softness={splitSoftness}
        data-show-split-line={String(visual.showSplitLine)}
        data-ascii-enabled={String(ascii.enabled)}
        data-ascii-density-mode={ascii.densityMode}
        data-ascii-resolution={ascii.resolution}
        data-ascii-cell-width={ascii.cellWidth}
        data-ascii-update-fps={ascii.updateFPS}
        data-ascii-charset={ascii.charset}
        data-ascii-invert={String(ascii.invert)}
        data-ascii-sample-count={ascii.sampleCount}
        data-ascii-sample-pattern={ascii.samplePattern}
        data-ascii-contrast={ascii.contrast}
        data-ascii-brightness={ascii.brightness}
        data-ascii-gamma={ascii.gamma}
        data-ascii-edge-boost={ascii.edgeBoost}
        data-ascii-edge-threshold={ascii.edgeThreshold}
        data-ascii-surface-fill={String(ascii.surfaceFill)}
        data-ascii-surface-fill-strength={ascii.surfaceFillStrength}
        data-ascii-surface-point-density={ascii.surfacePointDensity}
        data-ascii-depth-brightness={String(ascii.useDepthForBrightness)}
        data-ascii-depth-brightness-strength={ascii.depthBrightnessStrength}
        data-ascii-normal-lighting={String(ascii.useNormalLighting)}
        data-ascii-normal-lighting-strength={ascii.normalLightingStrength}
        data-ascii-edge-dominance={ascii.edgeDominance}
        data-ascii-pixel-sample-disable-on-mobile={String(ascii.pixelSampleDisableOnMobile)}
        data-ascii-color-sampling-enabled={String(ascii.colorSampling.enabled)}
        data-ascii-color-sampling-mode={ascii.colorSampling.mode}
        data-ascii-color-sampling-blend-mode={ascii.colorSampling.blendMode}
        data-ascii-color-sampling-strength={ascii.colorSampling.strength}
        data-ascii-color-sampling-saturation={ascii.colorSampling.saturation}
        data-ascii-color-sampling-brightness={ascii.colorSampling.brightness}
        data-ascii-color-sampling-contrast={ascii.colorSampling.contrast}
        data-ascii-color-sampling-alpha={ascii.colorSampling.alpha}
        data-ascii-color-sampling-grayscale-fallback={String(ascii.colorSampling.grayscaleFallback)}
        data-ascii-color-sampling-sample-background={String(ascii.colorSampling.sampleBackground)}
        data-ascii-color-sampling-min-alpha={ascii.colorSampling.minAlpha}
        data-ascii-color-sampling-force-visible-color-cells={String(ascii.colorSampling.forceVisibleColorCells)}
        data-ascii-color-sampling-minimum-character={ascii.colorSampling.minimumCharacter}
        data-ascii-color-sampling-minimum-color-luminance={ascii.colorSampling.minimumColorLuminance}
        data-ascii-color-sampling-visibility-boost={ascii.colorSampling.visibilityBoost}
        data-ascii-color-sampling-disable-on-mobile={String(ascii.colorSampling.disableOnMobile)}
        data-ascii-cell-aspect={ascii.cellAspect}
        data-ascii-font-size={ascii.fontSize}
        data-ascii-line-height={ascii.lineHeight}
        data-ascii-shape-aware-lookup={String(ascii.useShapeAwareLookup)}
        data-ascii-shape-vector-mode={ascii.shapeVectorMode}
        data-ascii-cached-lookup={String(ascii.useCachedLookup)}
        data-ascii-lookup-quantization={ascii.lookupQuantization}
        data-ascii-max-cache-entries={ascii.maxCacheEntries}
        data-ascii-disable-on-mobile={String(ascii.disableOnMobile)}
        data-orbit-controls={String(visual.enableOrbitControls)}
        data-orbit-enable-damping={String(orbit.enableDamping)}
        data-orbit-damping-factor={orbit.dampingFactor}
        data-orbit-enable-zoom={String(orbit.enableZoom)}
        data-orbit-enable-pan={String(orbit.enablePan)}
        data-orbit-auto-rotate={String(orbit.autoRotate)}
        data-orbit-auto-rotate-speed={orbit.autoRotateSpeed}
        data-orbit-min-polar-angle={orbit.minPolarAngle}
        data-orbit-max-polar-angle={orbit.maxPolarAngle}
        data-orbit-min-azimuth-angle={orbit.minAzimuthAngle}
        data-orbit-max-azimuth-angle={orbit.maxAzimuthAngle}
        data-orbit-rotate-speed={orbit.rotateSpeed}
        data-orbit-touch-rotate-speed={orbit.touchRotateSpeed}
        data-orbit-disable-on-mobile={String(orbit.disableOnMobile)}
        data-max-pixel-ratio={visual.maxPixelRatio}
        data-disable-on-mobile={String(visual.disableOnMobile)}
      />
    )
  }
</div>

{
  visual.enabled && (
    <script>
      import { destroyHeroThreeScenes, initHeroThreeScenes } from "../scripts/hero-three-scene";

      document.addEventListener("astro:page-load", initHeroThreeScenes);
      document.addEventListener("astro:before-swap", destroyHeroThreeScenes);
      initHeroThreeScenes();
    </script>
  )
}
