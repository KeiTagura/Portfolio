---
import { getUi } from "@data/ui";

const ui = getUi();
---

<div class="lightbox" data-lightbox hidden>
  <div class="lightbox-panel" data-lightbox-panel role="dialog" aria-modal="true" tabindex="-1">
    <div class="lightbox-toolbar">
      <button type="button" data-lightbox-prev aria-label={`${ui.common.previous} gallery item`}>{ui.common.previous}</button>
      <button type="button" data-lightbox-next aria-label={`${ui.common.next} gallery item`}>{ui.common.next}</button>
      <button class="lightbox-close" type="button" data-lightbox-close aria-label={ui.common.closePreview}>
        {ui.common.closePreview}
      </button>
    </div>
    <div class="lightbox-media">
      <img data-lightbox-image alt="" hidden />
      <video data-lightbox-video controls playsinline muted hidden></video>
      <iframe data-lightbox-embed title="Media preview" loading="lazy" allowfullscreen hidden></iframe>
      <a class="lightbox-external" data-lightbox-external href="#" target="_blank" rel="noreferrer" hidden>
        <span>{ui.common.externalMedia}</span>
        <strong data-lightbox-external-label>{ui.common.externalMedia}</strong>
      </a>
    </div>
    <div class="lightbox-caption" data-lightbox-caption></div>
  </div>
</div>

<script>
  const lightbox = document.querySelector("[data-lightbox]");
  const lightboxPanel = document.querySelector("[data-lightbox-panel]");
  const lightboxImage = document.querySelector("[data-lightbox-image]");
  const lightboxVideo = document.querySelector("[data-lightbox-video]");
  const lightboxEmbed = document.querySelector("[data-lightbox-embed]");
  const lightboxExternal = document.querySelector("[data-lightbox-external]");
  const lightboxExternalLabel = document.querySelector("[data-lightbox-external-label]");
  const lightboxCaption = document.querySelector("[data-lightbox-caption]");
  const closeButton = document.querySelector("[data-lightbox-close]");
  const prevButton = document.querySelector("[data-lightbox-prev]");
  const nextButton = document.querySelector("[data-lightbox-next]");
  const galleryTriggers = Array.from(document.querySelectorAll("[data-lightbox-trigger]"));
  let currentGalleryIndex = 0;
  let previousFocus: Element | null = null;

  function resetLightboxMedia() {
    if (lightboxImage instanceof HTMLImageElement) {
      lightboxImage.hidden = true;
      lightboxImage.removeAttribute("src");
    }
    if (lightboxVideo instanceof HTMLVideoElement) {
      lightboxVideo.hidden = true;
      lightboxVideo.pause();
      lightboxVideo.removeAttribute("src");
      lightboxVideo.load();
    }
    if (lightboxEmbed instanceof HTMLIFrameElement) {
      lightboxEmbed.hidden = true;
      lightboxEmbed.removeAttribute("src");
    }
    if (lightboxExternal instanceof HTMLAnchorElement) {
      lightboxExternal.hidden = true;
      lightboxExternal.href = "#";
    }
  }

  function getVisibleTriggers() {
    return galleryTriggers.filter((trigger) => {
      if (!(trigger instanceof HTMLElement)) {
        return false;
      }
      const item = trigger.closest("[data-gallery-item]");
      return !(item instanceof HTMLElement) || !item.hidden;
    });
  }

  function renderLightboxMedia(trigger: HTMLElement) {
    resetLightboxMedia();
    const mediaType = trigger.getAttribute("data-media-type") ?? "image";
    const mediaSrc = trigger.getAttribute("data-media-src") ?? "";
    const alt = trigger.getAttribute("data-alt") ?? "";
    const title = trigger.getAttribute("data-title") ?? "Gallery item";

    if ((mediaType === "image" || mediaType === "gif") && lightboxImage instanceof HTMLImageElement) {
      lightboxImage.src = mediaSrc;
      lightboxImage.alt = alt;
      lightboxImage.hidden = false;
      return;
    }

    if (mediaType === "localVideo" && lightboxVideo instanceof HTMLVideoElement) {
      lightboxVideo.src = mediaSrc;
      lightboxVideo.muted = true;
      lightboxVideo.hidden = false;
      return;
    }

    if ((mediaType === "youtube" || mediaType === "vimeo") && lightboxEmbed instanceof HTMLIFrameElement) {
      lightboxEmbed.src = mediaSrc;
      lightboxEmbed.title = `${title} embedded media`;
      lightboxEmbed.hidden = false;
      return;
    }

    if (lightboxExternal instanceof HTMLAnchorElement) {
      lightboxExternal.href = mediaSrc;
      lightboxExternal.hidden = false;
    }
    if (lightboxExternalLabel instanceof HTMLElement) {
      lightboxExternalLabel.textContent = `Open ${mediaType} media`;
    }
  }

  function renderLightboxCaption(trigger: HTMLElement) {
    if (!(lightboxCaption instanceof HTMLElement)) {
      return;
    }
    const title = trigger.getAttribute("data-title") ?? "";
    const description = trigger.getAttribute("data-description") ?? "";
    const hasCaption = Boolean(title || description);
    lightboxCaption.replaceChildren();
    lightboxCaption.hidden = !hasCaption;
    lightboxPanel instanceof HTMLElement && lightboxPanel.classList.toggle("has-empty-caption", !hasCaption);
    if (title) {
      const heading = document.createElement("h3");
      heading.textContent = title;
      lightboxCaption.append(heading);
    }
    if (description) {
      const copy = document.createElement("p");
      copy.textContent = description;
      lightboxCaption.append(copy);
    }
  }

  function openLightbox(index: number) {
    const visibleTriggers = getVisibleTriggers();
    if (visibleTriggers.length === 0) {
      return;
    }
    const normalizedIndex = (index + visibleTriggers.length) % visibleTriggers.length;
    const trigger = visibleTriggers[normalizedIndex];
    if (!(trigger instanceof HTMLElement)) {
      return;
    }

    currentGalleryIndex = normalizedIndex;
    previousFocus = document.activeElement;
    renderLightboxMedia(trigger);
    renderLightboxCaption(trigger);
    lightbox?.removeAttribute("hidden");
    document.body.classList.add("has-lightbox");
    if (lightboxPanel instanceof HTMLElement) {
      lightboxPanel.focus();
    }
  }

  function closeLightbox() {
    resetLightboxMedia();
    lightbox?.setAttribute("hidden", "");
    document.body.classList.remove("has-lightbox");
    if (previousFocus instanceof HTMLElement) {
      previousFocus.focus();
    }
  }

  function moveLightbox(direction: number) {
    openLightbox(currentGalleryIndex + direction);
  }

  galleryTriggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const visibleTriggers = getVisibleTriggers();
      openLightbox(visibleTriggers.indexOf(trigger));
    });
  });

  closeButton?.addEventListener("click", closeLightbox);
  prevButton?.addEventListener("click", () => moveLightbox(-1));
  nextButton?.addEventListener("click", () => moveLightbox(1));
  lightbox?.addEventListener("click", (event) => {
    if (event.target === lightbox) {
      closeLightbox();
    }
  });
  document.addEventListener("keydown", (event) => {
    if (lightbox?.hasAttribute("hidden")) {
      return;
    }

    if (event.key === "Escape") {
      closeLightbox();
    } else if (event.key === "ArrowLeft") {
      moveLightbox(-1);
    } else if (event.key === "ArrowRight") {
      moveLightbox(1);
    }
  });
</script>
